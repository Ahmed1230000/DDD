    ) {
        {{ authorize_resource }}
    }

    public function index()
    {
        try {
            {{ index_logic }}
        } catch (\Throwable $e) {
            $this->logMessage('Fetch {{ entity }} Failed', [
                'error' => $e->getMessage()
            ], 'error');

            return $this->apiResponse(null, 'Something went wrong', 500);
        }
